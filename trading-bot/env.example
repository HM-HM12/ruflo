# Copy this file to `.env` (in trading-bot/) and fill in real values.
# NEVER commit .env — it is already covered by the repo's .gitignore rules
# for env files; double check before committing if you rename this.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Trading mode (safety-critical) -----------------------------------
# Paper trading is the ONLY mode enabled by default. To ever enable live
# trading against a real simulated broker (BROKER_PLATFORM=simulated, the
# default) you must deliberately set ALL THREE of the following, AND wire a
# real broker adapter into src/execution/live_broker_stub.py. For MT5, see
# the dedicated section below instead — demo vs. real is determined by
# which account your terminal is logged into, verified live by the code,
# not by these flags alone.
BROKER_MODE=paper
LIVE_TRADING_CONFIRMED=false
LIVE_TRADING_CONFIRMATION_PHRASE=

# Which broker actually places orders: "simulated" (default, fully
# synthetic, touches nothing real) or "mt5" (MetaTrader 5).
BROKER_PLATFORM=simulated
# Which provider feeds market data: yfinance (default), alpaca, ccxt, or mt5.
DATA_PROVIDER=yfinance

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading_bot
REDIS_URL=redis://localhost:6379/0

# --- Market data provider credentials -----------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

BINANCE_API_KEY=
BINANCE_SECRET_KEY=

POLYGON_API_KEY=

# --- MetaTrader 5 (gold / XAUUSD) -----------------------------------------
# Requires a locally running MT5 terminal on the SAME machine as this bot
# (Windows only — see trading-bot/SETUP.md's MT5 section). To paper-trade,
# log the terminal into a DEMO account and leave BROKER_MODE=paper; the
# code independently verifies the account type on every connection and
# refuses to run if it doesn't match what BROKER_MODE expects.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
# Gold's exact symbol name is broker-specific — check your MT5 Market
# Watch panel. Common variants: XAUUSD, XAUUSD.a, XAUUSDm, GOLD.
MT5_SYMBOL=XAUUSD
MT5_LOT_STEP=0.01
MT5_MIN_LOT=0.01
MT5_MAX_LOT=100.0
MT5_DEVIATION_POINTS=20

# --- News provider credentials -------------------------------------------
NEWSAPI_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- Alerting -------------------------------------------------------------
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Risk defaults (see config/risk.yaml for the full set) ---------------
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_TRADES_PER_DAY=10
MAX_SIMULTANEOUS_POSITIONS=5
MAX_EXPOSURE_PER_ASSET_PCT=20.0
CONSECUTIVE_LOSS_CIRCUIT_BREAKER=3
CIRCUIT_BREAKER_COOLDOWN_MINUTES=60

# --- AI decision engine ----------------------------------------------------
MIN_CONFIDENCE_THRESHOLD=65.0

# --- API / dashboard ---------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

STARTING_EQUITY=100000.0
